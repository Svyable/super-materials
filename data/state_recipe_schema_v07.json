{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svyable.github.io/super-materials/schema/state_recipe_v07.json",
  "title": "Superconducting retained-state recipe v0.7",
  "description": "Minimum machine-readable record for material + preparation path + retained state + same-state measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id",
    "material",
    "precursor",
    "preparation_path",
    "retained_state",
    "measurements",
    "evidence"
  ],
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula"
      ],
      "properties": {
        "formula": {
          "type": "string"
        },
        "composition_notes": {
          "type": "string"
        },
        "isotope": {
          "type": "string"
        },
        "defect_model": {
          "type": "string"
        }
      }
    },
    "precursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "microstructure": {
          "type": "string"
        },
        "batch_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "preparation_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "action",
          "pressure_gpa",
          "temperature_k",
          "duration_s"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string"
          },
          "pressure_gpa": {
            "type": "number",
            "minimum": 0
          },
          "temperature_k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_s": {
            "type": "number",
            "minimum": 0
          },
          "heating_method": {
            "type": "string"
          },
          "hydrogen_source": {
            "type": "string"
          },
          "decompression_rate_gpa_per_s": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "retained_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure_gpa",
        "temperature_k",
        "elapsed_time_s",
        "status"
      ],
      "properties": {
        "pressure_gpa": {
          "type": "number",
          "minimum": 0
        },
        "temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elapsed_time_s": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "retained",
            "failed",
            "ambiguous"
          ]
        },
        "phase_fingerprint": {
          "type": "string"
        },
        "stoichiometry_estimate": {
          "type": "string"
        },
        "failure_mode": {
          "type": "string"
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_type",
          "same_state",
          "result_summary"
        ],
        "properties": {
          "measurement_type": {
            "enum": [
              "xrd",
              "raman",
              "ir",
              "transport_4probe",
              "magnetic",
              "thermodynamic",
              "hall",
              "tunneling",
              "other"
            ]
          },
          "same_state": {
            "type": "boolean"
          },
          "result_summary": {
            "type": "string"
          },
          "raw_data_uri": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "replication_status"
      ],
      "properties": {
        "class": {
          "enum": [
            "anomaly",
            "transport",
            "phase_linked",
            "bulk_consistent",
            "mechanism_resolved",
            "independently_replicated"
          ]
        },
        "replication_status": {
          "enum": [
            "none",
            "internal",
            "independent"
          ]
        },
        "source_doi": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
